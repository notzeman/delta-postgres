{
  "name": "delta-postgres",
  "version": "1.0.0",
  "private": true,
  "description": "Borg-backed PostgreSQL backup dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm --prefix web run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "create-admin": "node dist/cli.js create-admin",
    "reset-admin": "node dist/cli.js reset-password",
    "create-admin:dev": "tsx src/cli.ts create-admin",
    "reset-admin:dev": "tsx src/cli.ts reset-password",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@inquirer/prompts": "^8.7.5",
    "bcryptjs": "^2.4.3",
    "cron-parser": "^4.9.0",
    "dockerode": "^4.0.5",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "ssh2": "^1.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^3.3.35",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/ssh2": "^1.15.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
