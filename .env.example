# ---------------------------------------------------------------------------
# DeltaPostgres environment
# Copy to .env and replace every "change-me" value before exposing the service.
# Admin users are created with `npm run create-admin` after the stack starts.
# ---------------------------------------------------------------------------

# Session signing secret (random 32+ bytes)
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-session-secret

# Encryption key for remote Docker TLS credentials (random 32+ bytes).
# Generate: openssl rand -hex 32
# Changing this invalidates stored TLS certificates; re-enter them in the UI.
SECRETS_KEY=change-me-secrets-key

# Password for the dashboard's own metadata Postgres container
# Generate: openssl rand -hex 24
DASHBOARD_DB_PASSWORD=change-me-db-password

# Borg repository encryption passphrase. LOSS = UNRECOVERABLE BACKUPS.
# Generate: openssl rand -hex 32
BORG_PASSPHRASE=change-me-borg-passphrase

# Set to true when serving the dashboard over HTTPS
COOKIE_SECURE=false

# Network / runtime
# Bind to loopback so only the local reverse proxy (or an SSH tunnel) can reach it.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8095

# Runtime UID/GID and Docker socket GID are auto-detected by the entrypoint
# from ./data ownership and /var/run/docker.sock. They can still be overridden:
# APP_UID=1000
# APP_GID=1000
# DOCKER_GID=988

# Global schedule, timezone, concurrency, retention, webhook notifications,
# and auto-add behavior are configured in the dashboard Settings page.

# Optional overrides
# PORT=8080
# DOCKER_SOCKET=/var/run/docker.sock
# LOG_LEVEL=info
